{
  "name": "agent-im",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lint": "eslint app bench web/src web/vite.config.js",
    "format": "prettier --write \"app/**/*.mjs\" \"bench/**/*.mjs\" \"web/src/**/*.{js,jsx}\" \"web/vite.config.js\"",
    "check": "npm run lint && prettier --check \"app/**/*.mjs\" \"bench/**/*.mjs\" \"web/src/**/*.{js,jsx}\" \"web/vite.config.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.0"
  }
}
